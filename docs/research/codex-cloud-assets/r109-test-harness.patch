+  if (start < 0 || end < 0) throw new Error('Pinned fetchSavedTasks extent missing');
+  let fetch = text.slice(start, end);
+  fetch = replaceOnce(fetch, '  function fetchSavedTasks(memberId, revision, projection, signal, peerFor) {',

+// One anchor per document. No timers, retained rows, or activation of controls.
+const controllers = new WeakMap();
+export function taskFocusIdentity({ taskId, commandTaskId = taskId, category, owners, personal = false, checked = false }) {
+  return JSON.stringify([taskId, commandTaskId, category, owners, personal, checked]);
+}
+export function createScreenTaskFocus({ document, viewport = document.defaultView, scope }) {
+  controllers.get(document)?.dispose();
+  let view, generation, pending, internal = false, restoring = false, disposed = false;
+  let pages = new Map(), seen = new Set();
+  const cancel = () => { pending = undefined; };
+  const intent = () => { if (!internal && !restoring) cancel(); };
+  const events = ['pointerdown', 'keydown', 'input', 'change', 'focusin', 'toggle'];
+  for (const type of events) document.addEventListener(type, intent, true);
+  viewport?.addEventListener('blur', cancel);
+  const visibility = () => { if (document.visibilityState === 'hidden') cancel(); };
+  document.addEventListener('visibilitychange', visibility);
+  const eligible = node => node?.isConnected && !node.disabled && !node.hidden
+    && !node.closest('[hidden], [inert], details:not([open]), dialog:not([open])')
+    && node.getClientRects().length > 0;
+  function restore(host, current) {
+    if (disposed || !pending || current !== generation || pending.generation !== current) return;
+    if (scope() !== view || document.visibilityState === 'hidden' || !document.hasFocus()
+      || document.activeElement !== document.body || document.querySelector('dialog[open]')) { cancel(); return; }
+    if (host.id !== pending.list) return;
+    const match = [...host.querySelectorAll('input[type=checkbox][data-task-focus-key]')]
+      .find(node => node.dataset.taskFocusKey === pending.key && eligible(node));
+    if (!match) return;
+    // Permission comes from our synchronous removal below, never BODY alone.
+    cancel(); restoring = true;
+    try { match.focus({ preventScroll: true }); } finally { restoring = false; }
+  }
+  const api = {
+    begin(current) {
+      if (disposed) return;
+      const next = scope();
+      if (next !== view) { cancel(); pages.clear(); }
+      view = next; generation = current; seen = new Set();
+      if (pending) pending.generation = current;
+    },
+    replace(host, current, remove) {
+      if (disposed) { remove(); return; }
+      if (current !== generation) return;
+      const active = document.activeElement;
+      const key = active?.dataset?.taskFocusKey;
+      const capture = key && host.contains(active) && eligible(active)
+        ? { key, list: host.id, generation: current } : undefined;
+      internal = true;
+      try { remove(); } finally { internal = false; }
+      if (capture && !active.isConnected && document.activeElement === document.body) pending = capture;
+      else if (capture) cancel();
+    },
+    page(list, category, total, current) {
+      if (disposed) return Math.min(total, 70);
+      const key = JSON.stringify([list, category]); seen.add(key);
+      return Math.min(total, Math.max(70, pages.get(key) ?? 70));
+    },
+    shown(list, category, count, current) {
+      if (!disposed && current === generation) pages.set(JSON.stringify([list, category]), count);
+    },
+    inserted(host, current) { restore(host, current); },
+    seal(current) {
+      if (!disposed && current === generation) for (const key of pages.keys()) if (!seen.has(key)) pages.delete(key);
+    },
+    finish(current) { if (current === generation) cancel(); },
+    dispose() {
+      if (disposed) return;
+      disposed = true; cancel(); pages.clear(); seen.clear(); generation = undefined;
+      for (const type of events) document.removeEventListener(type, intent, true);
+      document.removeEventListener('visibilitychange', visibility);
+      viewport?.removeEventListener('blur', cancel);
+      viewport?.removeEventListener('pagehide', pagehide);
+      if (controllers.get(document) === api) controllers.delete(document);
+    },
+  };
+  // A persisted page is suspended, not dead; its intent listeners must survive.
+  const pagehide = event => { cancel(); if (!event.persisted) api.dispose(); };
+  viewport?.addEventListener('pagehide', pagehide);
+  controllers.set(document, api);
+  return api;
+}

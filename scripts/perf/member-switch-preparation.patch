+  if (transition === 'revision') { const next = h.snapshot(); next.revision++; h.adopt(next); }
+  if (transition === 'group') h.run("document.getElementById('group-view').checked = true; prepareMemberSwitch()");
+  if (transition === 'sandbox') h.run("Object.defineProperty(sandbox, 'active', { get: () => true }); prepareMemberSwitch()");
+  if (transition === 'command') h.run('beginGameplayAttempt(7)');
+  assert.equal(signal.aborted, true);
+  assert.equal(h.run('memberPreparation'), undefined);
+});
+
+for (const mode of ['viewer', 'group', 'cached', 'single', 'pending']) test(`member preparation skips ${mode}`, async () => {
+  const h = mode === 'viewer' ? viewerHarness() : harness();
+  h.context.currentPersonal = taskResult(7); h.run('result = currentPersonal');
+  if (mode === 'group') h.run("document.getElementById('group-view').checked = true");
+  if (mode === 'cached') h.run("normalPlayResults.set('reed', { ...currentPersonal, memberId: 'reed' })");
+  if (mode === 'single') h.run('state.members.pop()');
+  if (mode === 'pending') h.run('pendingGameplayAttempt = { observedRevision: 8 }');
+  h.run('prepareMemberSwitch(true)');
+  assert.equal(h.preparationCalls.length, 0);
+});
+
+test('a rapid member switch keeps preparation alive for the coalesced ordinary read', async () => {
+  const h = harness(); h.context.currentPersonal = taskResult(7);
+  await h.run('acceptTaskResult(currentPersonal)');
+  const signal = h.preparationCalls[0].options.signal;
+  h.run("memberId = 'reed'; result = undefined; prepareMemberSwitch()");
+  assert.equal(signal.aborted, false);
+  assert.equal(h.preparationCalls.length, 1);
+});

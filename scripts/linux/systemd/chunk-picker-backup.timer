[Unit]
Description=Daily Chunk Picker recovery backup with missed-run catchup

[Timer]
# 04:00 Atlantic time, the same hour as the Windows backup. Change the zone if the server serves another region.
OnCalendar=*-*-* 04:00:00 America/Moncton
Persistent=yes
AccuracySec=1min
Unit=chunk-picker-backup.service

[Install]
WantedBy=timers.target

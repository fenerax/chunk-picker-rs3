[Unit]
Description=Chunk Picker encrypted off-site backup
After=network-online.target chunk-picker-backup.service
Wants=network-online.target
OnFailure=chunk-picker-notify@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/chunk-picker/runtime.env
ExecStart=/usr/bin/node /opt/chunk-picker/tools/scripts/linux/offhost-backup.mjs
LoadCredential=b2-account:/etc/chunk-picker/secrets/b2-account
LoadCredential=b2-key:/etc/chunk-picker/secrets/b2-key
LoadCredential=restic-password:/etc/chunk-picker/secrets/restic-password
LoadCredential=offhost-ping:/etc/chunk-picker/secrets/offhost-ping
UMask=0077
# Bound each repository subprocess internally, but never SIGKILL while holding
# the shared operator exclusion. The independent monitor flags long operations.
TimeoutStartSec=infinity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/chunk-picker /var/backups/chunk-picker

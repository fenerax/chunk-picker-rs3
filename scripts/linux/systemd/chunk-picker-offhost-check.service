[Unit]
Description=Daily Chunk Picker off-site repository integrity check
After=network-online.target
Wants=network-online.target
OnFailure=chunk-picker-notify@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/chunk-picker/runtime.env
ExecStart=/usr/bin/node /opt/chunk-picker/tools/scripts/linux/offhost-backup.mjs check
LoadCredential=b2-account:/etc/chunk-picker/secrets/b2-account
LoadCredential=b2-key:/etc/chunk-picker/secrets/b2-key
LoadCredential=restic-password:/etc/chunk-picker/secrets/restic-password
UMask=0077
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=2G
TimeoutStartSec=125min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/chunk-picker
